{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: install",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements-dev.txt",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "windows": {
        "command": "python -m venv .venv; .venv\\Scripts\\python.exe -m pip install -r requirements-dev.txt"
      }
    },
    {
      "label": "Backend: run (port 8000)",
      "type": "shell",
      "command": ".venv/bin/python -m uvicorn app.main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "windows": {
        "command": ".venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000"
      }
    },
    {
      "label": "Frontend: install",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: run (port 5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run SyllaQuest (backend + frontend)",
      "dependsOn": [
        "Backend: run (port 8000)",
        "Frontend: run (port 5173)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Backend: tests",
      "type": "shell",
      "command": ".venv/bin/python -m pytest -q",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "windows": {
        "command": ".venv\\Scripts\\python.exe -m pytest -q"
      }
    }
  ]
}