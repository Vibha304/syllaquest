# Copy to ".env" (in the project root or in backend/). Every value is optional for local use.

# --- AI question generation (pick ONE free option; leave all blank to use the offline generator)
# Google Gemini free tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq free tier key (hosted Llama 3): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Fully local with Ollama (https://ollama.com): run `ollama pull llama3`, then set the URL
OLLAMA_URL=
OLLAMA_MODEL=llama3
# auto = first configured provider above; or force one: gemini | groq | ollama | offline
LLM_PROVIDER=auto

# --- Database: SQLite file by default; use a PostgreSQL URL in production (e.g. free Neon)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Security: set a long random string in production
SECRET_KEY=dev-secret-change-me-in-production-please

# Load demo accounts and the sample Computer Networks class on first start
SEED_DEMO=true
